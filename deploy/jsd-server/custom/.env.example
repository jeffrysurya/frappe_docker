# jsd-server / custom stack (frappe-16 + erpnext latest + custom procurement app + custom hrms fork)
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md
#
# Copy this file to .env (gitignored) and fill in the real secrets marked <...> below.
# Non-secret values (ports, redis db index, gunicorn sizing) are left at their
# real, current jsd-server values for reference.

ERPNEXT_VERSION=v16.29.0

CUSTOM_IMAGE=jsd-custom-erpnext
CUSTOM_TAG=16
PULL_POLICY=never

# External MariaDB on jsd-server — same instance as vanilla stack, fill in real values
DB_HOST=mariadb-prod
DB_PORT=3306
DB_PASSWORD=<mariadb-prod-db-password>

# Only if you use docker secrets for the db password
DB_PASSWORD_SECRETS_FILE=

# External Redis on jsd-server (compose.yaml already wraps this as redis://$REDIS_CACHE,
# so no redis:// prefix here; container hostname:port on the redis_default docker network)
REDIS_CACHE=:<redis-password>@redis-cache:13000/1
REDIS_QUEUE=:<redis-password>@redis-queue:11000/2

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

HTTP_PUBLISH_PORT=8092
