# jsd-server / commera stack (frappe-16 + erpnext + bwh_payments + bwh_shipping + commera)
# commera (https://github.com/bwhtech/commera) is an ecommerce extension for ERPNext; its
# storefront (Jinja/Alpine/Tailwind) and merchant dashboard (Vue 3) both ship inside the app
# itself and are served by the standard `frontend` nginx service — no separate frontend stack.
# commera is pinned to its v16-beta.1 tag; bwh_payments/bwh_shipping only have develop/main
# upstream (no version-16 branch or release tag yet) so they track develop; erpnext itself
# stays pinned to version-16. See ../README.md for the build/update procedure.
# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md
#
# Copy this file to .env (gitignored) and fill in the real secrets marked <...> below.
# Non-secret values (ports, redis db index, gunicorn sizing) are left at their
# real, current jsd-server values for reference.

# Unused while CUSTOM_IMAGE/CUSTOM_TAG are set (fallback only)
ERPNEXT_VERSION=v16.33.0

CUSTOM_IMAGE=jsd-commera-erpnext
CUSTOM_TAG=16
PULL_POLICY=never

# External MariaDB on jsd-server — same instance as vanilla/custom/shop stacks
DB_HOST=mariadb-prod
DB_PORT=3306
DB_PASSWORD=<mariadb-prod-db-password>

# Only if you use docker secrets for the db password
DB_PASSWORD_SECRETS_FILE=

# External Redis on jsd-server (compose.yaml already wraps this as redis://$REDIS_CACHE,
# so no redis:// prefix here; container hostname:port on the redis_default docker network)
REDIS_CACHE=:<redis-password>@redis-cache:13000/7
REDIS_QUEUE=:<redis-password>@redis-queue:11000/8

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

HTTP_PUBLISH_PORT=8094

# So the frontend serves this site regardless of Host header (accessing via IP:port, not domain)
FRAPPE_SITE_NAME_HEADER=commera.tataidekreatif.biz.id
